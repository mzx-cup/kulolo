# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/

# Local runtime / logs
*.log
*.tmp
*.bak

# Downloaded APK/XAPK caches (too large, not source)
apks/
*.apk
*.xapk

# Screenshots / large media are not source code (can be added separately)
screenshots/

# Large bundled music assets (12.8 MB) are not needed for the code
资源/音乐资源/

# Old web backup
_backup_web_*/

# Front-end toolchain: dependencies and build cache are not source
web-src/node_modules/
web-src/.vite/
web-src/dist/
*.tsbuildinfo

# OS/editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
# One-off local test scripts (temporary harnesses, not part of the tool)
_t_*.py
_t_*.json

# Runtime state written by scenarios at run time (not source)
boomplay_music_state.json

# One-file exe build output (release artifacts go to GitHub Releases, not git)
build/
dist/
*.spec
fixtures.json
